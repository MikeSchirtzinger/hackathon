{
  "manifest_version": 3,
  "name": "Spark",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "power",
    "scripting",
    "alarms",
    "notifications"
  ],
  "version": "0.3.0",
  "description": "Keep browser context with local notes and meeting follow-through.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Open Spark",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "foundation/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' blob: https://app.ambiguous.ai http://127.0.0.1:4318; worker-src 'self'; media-src 'self' blob:"
  },
  "minimum_chrome_version": "127",
  "host_permissions": [
    "https://app.ambiguous.ai/*"
  ],
  "commands": {
    "capture-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Save current page context quietly"
    },
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open the Spark popup"
    }
  },
  "options_ui": {
    "page": "panel.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "http://127.0.0.1:4318/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "surface.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
