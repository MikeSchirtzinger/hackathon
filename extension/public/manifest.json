{
  "manifest_version": 3,
  "name": "Context Carry",
  "version": "0.1.0",
  "description": "Keep browser context with local notes and meeting follow-through.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "alarms", "notifications"],
  "host_permissions": ["https://app.ambiguous.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Context Carry" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "capture-context": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }, "description": "Save current page context quietly" },
    "open-panel": { "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" }, "description": "Open notes and meeting controls" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://app.ambiguous.ai" }
}
