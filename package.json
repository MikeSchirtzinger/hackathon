{
  "name": "brevity-hackathon",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "verify": "npm run check && npm test && npm run build && node scripts/verify.mjs && npm run check:assets && npm run check:publication",
    "test:browser": "node tests/browser.cjs",
    "prepare:assets": "node prepare-assets.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:foundation": "node scripts/browser-proof.mjs",
    "test:integration": "node scripts/audio-integration-proof.mjs",
    "test:demo": "node scripts/demo-browser-proof.mjs",
    "test:hosted": "node scripts/hosted-browser-proof.mjs",
    "test:tab-capture": "node scripts/tab-capture-proof.mjs",
    "test:proactive": "node scripts/proactive-browser-proof.mjs",
    "test:auto-hosted": "node scripts/automatic-hosted-proof.mjs",
    "test:disconnect": "node scripts/disconnect-browser-proof.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test:concept": "node scripts/concept-browser-proof.mjs",
    "test:listening-surface": "node scripts/listening-surface-proof.mjs",
    "setup:assets": "node scripts/setup-speech-assets.mjs",
    "check:assets": "node scripts/setup-speech-assets.mjs --check",
    "setup": "npm run setup:assets && npm run build",
    "test:speech": "node scripts/speech-controls-proof.mjs",
    "test:speech-runtime": "node scripts/speech-runtime-proof.mjs",
    "test:speech-lifecycle": "node scripts/speech-lifecycle-proof.mjs",
    "test:speech-response": "node scripts/speech-response-proof.mjs",
    "test:speech-restart": "node scripts/speech-restart-proof.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "playwright": "1.63.0"
  },
  "type": "module"
}
